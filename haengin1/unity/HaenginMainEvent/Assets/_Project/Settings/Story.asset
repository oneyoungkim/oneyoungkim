  - "[\uB9E4\uB2EC \uBB34\uC870\uAC74 \uB098\uAC00\uB294 \uB3C8]"
  - "\uC6D4\uC138 55\uB9CC \uC6D0. \uB300\uCD9C 40\uB9CC \uC6D0. \uAD00\uB9AC\uBE44\uB791
    \uACF5\uACFC\uAE08 25\uB9CC \uC6D0."
  - "1,200,000\uC6D0"
  QuestHead: "\u3008\uBC18\uD558\uB298 11\uC138 \uC0DD\uC77C \uC694\uAD6C\uC0AC\uD56D
    (\uCD5C\uC885_\uC9C4\uC9DC\uCD5C\uC885)\u3009"
  QuestMemo:
  - "1. \uCF00\uC774\uD06C: 2\uD638. \uCD08\uCF54 \uC0DD\uD06C\uB9BC. \uB538\uAE30
    \uB9D0\uACE0 \uCD08\uCF54\uBCFC."
  - "2. \uCD08: \uC22B\uC790 \uCD08 \uAE08\uC9C0. \uAE34 \uCD08 11\uAC1C. (\uC18C\uC6D0
    11\uAC1C \uBE4C \uC608\uC815)"
  - "3. \uCF00\uC774\uD06C \uAE00\uC528: '\uD558\uB298\uC544 \uC0DD\uC77C \uCD95\uD558\uD574'
    \uAE08\uC9C0. '\uBC18\uD558\uB298 \uB2D8 \uC0DD\uC77C \uCD95\uD558\uB4DC\uB9BD\uB2C8\uB2E4'."
  - "4. \uC7A5\uC18C: \uAD6D\uBC25\uC9D1. \uAC00\uAC8C \uB05D\uB098\uACE0. (\uC0AC\uC7A5
    \uD560\uBA38\uB2C8 \uD5C8\uB77D \uC644\uB8CC)"
  - "5. \uC0DD\uC77C \uB178\uB798: \uC624\uBE60\uB294 1\uC808\uB9CC."
  IntroTitle: "1\uB9C9 \u300C\uD589\uC7781\u300D"
  Intro:
  - "\uB204\uAC00 \u2014 \uBC18\uC2DC\uC6B0, 17\uC0B4. \uD61C\uC131\uACE0 2\uD559\uB144
    3\uBC18. \uC0C8\uBCBD\uC5D4 \uC5C4\uB9C8 \uAD6D\uBC25\uC9D1 \uBC30\uB2EC, \uAD50\uC2E4\uC5D0\uC120
    \uCD9C\uC11D\uBD80\uC5D0 \uC774\uB984\uC774 \uC548 \uBD88\uB9AC\uB294 '\uD589\uC7781'."
  - "\uC5B4\uB514\uC11C \u2014 \uC11C\uC6B8 \uD61C\uD654\uB3D9. \uC131\uB300 \uD6C4\uBB38
    \uACE8\uBAA9, \uC640\uB8E1\uACF5\uC6D0 \uC131\uACFD\uAE38, 2026\uB144 \uBD04."
  - "\uBB34\uC5C7\uC744 \u2014 \uB3D9\uC0DD \uD558\uB298\uC774\uC758 \uC5F4\uD55C
    \uC0B4 \uC0DD\uC77C(5\uC6D4 1\uC77C)\uAE4C\uC9C0 \uCF00\uC774\uD06C\uAC12 4\uB9CC
    \uC6D0\uC744 \uBD09\uD22C\uC5D0 \uBAA8\uC740\uB2E4. \uB300\uC2E0 \uC544\uBB34\uB9AC
    \uAC74\uB4DC\uB824\uB3C4 '\uCC38\uB294\uB2E4'."
  - "\uADF8\uB9AC\uACE0 \u2014 \uCC38\uC740 \uB9CC\uD07C \uC313\uC778 \uAC83\uC774
    \uCC98\uC74C\uC73C\uB85C \uD130\uC9C0\uB294 \uB0A0\uAE4C\uC9C0, 7\uD654."
  IntroNote: "\uC81C\uC791 \uC911\uC778 \uC7A5\uBA74\uC740 '\uC2A4\uD1A0\uB9AC\uBCF4\uB4DC
    \uCE74\uB4DC'\uB85C \uBCF4\uC778\uB2E4(\uC6D0\uACE0 \uC694\uC57D\uACFC \uD575\uC2EC
    \uB300\uC0AC). \xD7 \xB7 Enter \xB7 \uB9C8\uC6B0\uC2A4 \uC67C\uCABD\uC744 \uB20C\uB7EC\uC57C
    \uB118\uC5B4\uAC04\uB2E4."
