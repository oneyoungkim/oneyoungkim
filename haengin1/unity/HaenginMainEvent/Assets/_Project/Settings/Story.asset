  Episodes:
  - No: 1
    Title: "\uCD9C\uC11D\uBD80\uC5D0 \uC5C6\uB294 \uC774\uB984"
    Dates: "3\uC6D4 3\uC77C"
    Ledger: "\uC0C8\uBCBD \uBC30\uB2EC 4\uAC74 +8,000\uC6D0 \u2192 \uC5C4\uB9C8 \uD1B5\uC7A5.
      \uBC1B\uC740 \uC774\uB984 3\uAC1C. \uC9C0\uAC11 2,600\uC6D0"
    First: 1-0
  - No: 2
    Title: "\uD589\uC7781\uC758 \uAC00\uACC4\uBD80"
    Dates: "3\uC6D4 4\uC77C ~ 3\uC6D4 6\uC77C"
    Ledger: "\uB9E4\uB2EC \uBB34\uC870\uAC74 \uB098\uAC00\uB294 \uB3C8 1,200,000\uC6D0.
      \uC9C0\uAC11 2,600\uC6D0. \uD558\uB298 \uCF00\uC774\uD06C 5,000 / 40,000"
    First: 2-0
  - No: 3
    Title: "\uC720\uD1B5\uAE30\uD55C \uD55C \uC2DC\uAC04 \uC804"
    Dates: "3\uC6D4 10\uC77C ~ 3\uC6D4 14\uC77C"
    Ledger: "\uD3B8\uC758\uC810 \uC785\uACE0 \uC6D4\uAE09 = \uD3D0\uAE30 \uC0BC\uAC01\uAE40\uBC25
      2\uAC1C. \uD558\uB298 \uCF00\uC774\uD06C 5,000 / 40,000"
    First: 3-0
  - No: 4
    Title: "\uB178\uAC00\uB2E4\uB294 \uD558\uCCB4\uB2E4"
    Dates: "3\uC6D4 14\uC77C ~ 3\uC6D4 16\uC77C"
    Ledger: "\uC77C\uB2F9 120,000\uC6D0 \u2192 \uAD00\uB9AC\uBE44 \uACE0\uC9C0\uC11C
      \uBC11. \uD558\uB298 \uCF00\uC774\uD06C 10,000 / 40,000"
    First: 4-0
  - No: 5
    Title: "\uBD09\uD22C"
    Dates: "3\uC6D4 17\uC77C ~ 5\uC6D4 1\uC77C"
    Ledger: "[4\uC6D4 30\uC77C \uBC24] \uD558\uB298 \uCF00\uC774\uD06C \uBD09\uD22C
      40,000\uC6D0. \uC9C0\uAC11 3,400\uC6D0. \uB0A8\uB294 \uB3C8 0\uC6D0."
