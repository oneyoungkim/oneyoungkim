  Lines:
  - Id: T2.01
    Scene: T2
    No: 1
    Who: "\uC5C4\uB9C8"
    Face: angry
    Mode: 0
    Text: "\uC2DC\uC6B0\uC57C! \uAF2D\uB300\uAE30 \uC9D1 \uB450 \uAC1C, \uACBD\uBE44\uC2E4
      \uD558\uB098, \uC18C\uADF9\uC7A5 \uD558\uB098!\\n\uAD6D\uBB3C \uD758\uB9AC\uBA74
      \uB108 \uC8FD\uC5B4!"
    Wait: 0
    Cam: "\uADFC\uC811"
    Note: "1\uD654 \uC6D0\uACE0 \uCCAB \uB300\uC0AC"
  - Id: T2.02
    Scene: T2
    No: 2
    Who: "\uC2DC\uC6B0"
    Face: 
    Mode: 1
    Text: "\uD758\uB9B0 \uC801\uC740 \uC5C6\uB2E4. \uC544\uC9C1 \uC0B4\uC544 \uC788\uB2E4."
    Wait: 0
    Cam: 
    Note: 
  - Id: T2.03
    Scene: T2
    No: 3
    Who: "\uC5C4\uB9C8"
    Face: normal
    Mode: 0
    Text: "\uAF2D\uB300\uAE30 \uD560\uC544\uBC84\uC9C0 \uC774 \uC5C6\uC5B4. \uACE0\uAE30
      \uC798\uAC8C \uC370\uC5C8\uC5B4.\\n\uBE68\uB9AC. \uC2DD\uC5B4."
    Wait: 0
    Cam: 
    Note: 
  - Id: T2.04
    Scene: T2
    No: 4
    Who: "\uC2DC\uC6B0"
    Face: normal
    Mode: 0
    Text: "\uC5C4\uB9C8, \uD558\uB298\uC774\uB294?"
    Wait: 0
    Cam: 
    Note: 
  - Id: T2.05
    Scene: T2
    No: 5
    Who: "\uC5C4\uB9C8"
    Face: normal
    Mode: 0
    Text: "\uB124\uAC00 \uAE68\uC6CC. \uB098 \uAE4D\uB450\uAE30."
    Wait: 0
    Cam: 
    Note: 
  - Id: T2.06
    Scene: T2
    No: 6
    Who: "\uC2DC\uC6B0"
    Face: 
    Mode: 1
    Text: "\uAE4D\uB450\uAE30\uD55C\uD14C \uC84C\uB2E4. \uC624\uB298\uB3C4."
