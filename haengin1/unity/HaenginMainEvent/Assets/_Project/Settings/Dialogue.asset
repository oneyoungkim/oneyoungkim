    No: 6
    Who: "\uC2DC\uC6B0"
    Face: 
    Mode: 3
    Text: "\uADF8 \uC774\uC720\uB294 \uD55C \uB2EC\uC5D0 \uBC31\uC774\uC2ED\uB9CC
