    BuffKinds:
    - stamina
    - hp
    - cond
    BuffNames:
    - "\uC2A4\uD0DC\uBBF8\uB098"
    - "\uCCB4\uB825"
    - "\uCEE8\uB514\uC158"
    BuffNotes:
    - "\uB4DC\uB294 \uD53C\uB85C \u2212%"
    - "\uC2F8\uC6C0 \uCCB4\uB825 +%"
    - "\uB4DC\uB9B4 \uD310\uC815 +"
    Lines:
    - Coach: yunjun
      Kind: intro
      Text: "\uD559\uC0DD\uC774\uB77C \uBC18\uB9CC \uBC1B\uB294\uB2E4. \uB300\uC2E0
        \uD55C \uC2DC\uAC04 \uB3D9\uC548\uC740 \uB0B4 \uB9D0\uB9CC \uB4E4\uC5B4."
    - Coach: yunjun
      Kind: start
      Text: "\uC624\uB298\uC740 \uD558\uB098\uB9CC \uACE0\uCE5C\uB2E4. \uD558\uB098."
    - Coach: yunjun
      Kind: start
      Text: "MMA\uB294 \uC608\uC220\uC774\uB2E4. \uC120 \uD558\uB098\uC529 \uAE0B\uB294
        \uAC70\uC57C."
    - Coach: yunjun
      Kind: start
      Text: "\uBAB8 \uD480\uB838\uC9C0. \uBC14\uB85C \uAC04\uB2E4."
    - Coach: yunjun
      Kind: cue
      Text: "\uD131."
    - Coach: yunjun
      Kind: cue
      Text: "\uBC1C \uBA3C\uC800."
    - Coach: yunjun
      Kind: cue
      Text: "\uC228 \uB0B4\uC26C\uBA74\uC11C \uCCD0."
    - Coach: yunjun
      Kind: cue
      Text: "\uCE58\uACE0 \uBE60\uC838."
    - Coach: yunjun
      Kind: cue
      Text: "\uC5B4\uAE68 \uD798 \uBE7C."
    - Coach: yunjun
      Kind: cue
      Text: "\uAC70\uB9AC. \uAC70\uB9AC \uBD10."
    - Coach: yunjun
      Kind: good
      Text: "\uADF8\uAC70\uC57C. \uC9C0\uAE08 \uADF8 \uB290\uB08C \uAE30\uC5B5\uD574."
    - Coach: yunjun
      Kind: ok
      Text: "\uBC18\uC740 \uB410\uB2E4. \uB098\uBA38\uC9C0 \uBC18\uC740 \uB2E4\uC74C
        \uC2DC\uAC04\uC5D0."
    - Coach: yunjun
      Kind: bad
      Text: "\uAD1C\uCC2E\uC544. \uD2C0\uB9B0 \uAC78 \uC54C\uBA74 \uBC18\uC740 \uACE0\uCE5C
        \uAC70\uB2E4."
    - Coach: yunjun
      Kind: tech
      Text: "\uC774\uC81C \uADF8\uB0E5 \uC6D0\uD22C\uAC00 \uC544\uB2C8\uB77C, \uAC70\uB9AC\uB97C
        \uC7AC\uACE0 \uCE58\uB294 \uC6D0\uD22C\uB2E4."
    - Coach: yunjun
      Kind: noshow
      Text: "\uB808\uC2A8 \uC2DC\uAC04 \uC9C0\uB0AC\uB2E4. \uB3C8\uC740 \uBABB \uB3CC\uB824\uC900\uB2E4.
        \uB2E4\uC74C\uC5D4 \uBBF8\uB9AC \uB9D0\uD574."
    - Coach: yunjun
      Kind: book
      Text: "\uC608\uC57D \uBC1B\uC558\uB2E4. \uB2A6\uC9C0 \uB9C8."
    - Coach: gojun
      Kind: intro
      Text: "\uC120\uBC30\uAC00 \uB3C8 \uBC1B\uB294 \uAC70 \uC880 \uADF8\uB807\uC9C0?
        \uBC25\uAC12\uB9CC \uBC1B\uB294\uB2E4. \uB300\uC2E0 \uBD10\uC8FC\uB294 \uAC70
        \uC5C6\uB2E4."
    - Coach: gojun
      Kind: start
      Text: "\uC624\uB298\uC740 \uAE54\uB9AC\uB294 \uC5F0\uC2B5\uBD80\uD130. \uAE54\uB824
        \uBD10\uC57C \uC548\uB2E4."
    - Coach: gojun
      Kind: start
      Text: "\uC2A4\uD30C\uB9C1\uC740 \uC774\uAE30\uB824\uACE0 \uD558\uB294 \uAC8C
        \uC544\uB2C8\uC57C. \uBC30\uC6B0\uB824\uACE0 \uD558\uB294 \uAC70\uC9C0."
    - Coach: gojun
      Kind: cue
      Text: "\uACE8\uBC18 \uBD99\uC5EC!"
    - Coach: gojun
      Kind: cue
      Text: "\uD314 \uBED7\uC9C0 \uB9C8, \uC7A1\uD78C\uB2E4!"
    - Coach: gojun
      Kind: cue
      Text: "\uC228 \uC26C\uC5B4, \uC228!"
    - Coach: gojun
      Kind: cue
      Text: "\uBCBD! \uBCBD \uC368!"
    - Coach: gojun
      Kind: cue
      Text: "\uC88B\uC544, \uD55C \uBC88 \uB354!"
    - Coach: gojun
      Kind: good
      Text: "\uC57C, \uC774\uAC70 \uB098\uBCF4\uB2E4 \uB0AB\uB2E4? \u2026\uB18D\uB2F4\uC774\uB2E4."
    - Coach: gojun
      Kind: ok
      Text: "\uB098\uC058\uC9C0 \uC54A\uC544. \uAD00\uC7A5\uB2D8\uD55C\uD150 \uBE44\uBC00\uB85C
        \uD574 \uC904\uAC8C."
    - Coach: gojun
      Kind: bad
      Text: "\uCC98\uC74C\uC5D4 \uB2E4 \uADF8\uB798. \uB098\uB3C4 \uB9E8\uB0A0 \uAE54\uB838\uC5B4."
    - Coach: gojun
      Kind: tech
      Text: "\uADF8\uAC8C \uC6D4\uC6CC\uD06C\uC57C. \uC774\uC81C \uAE54\uB824\uB3C4
        \uB35C \uBB34\uC12D\uC9C0?"
    - Coach: gojun
      Kind: noshow
      Text: "\uC57C \uC5B4\uB514\uC57C? \uB9E4\uD2B8 \uAE54\uC544 \uB193\uACE0 \uAE30\uB2E4\uB838\uB2E4.
        \uB3C8\uC740\u2026 \uAD00\uC7A5\uB2D8\uC774 \uC6D0\uB798 \uADF8\uB7F0 \uAC70\uB798."
    - Coach: gojun
      Kind: book
      Text: "\uC624\uCF00\uC774, \uADF8 \uC2DC\uAC04\uC5D0 \uB9E4\uD2B8 \uBE44\uC6CC
        \uB193\uC744\uAC8C."
    - Coach: seungyeon
      Kind: intro
      Text: "\uAD00\uC7A5\uB2D8\uD55C\uD14C \uC598\uAE30 \uB4E4\uC5C8\uC5B4. \uAE30\uBCF8\uBD80\uD130
        \uAC19\uC774 \uBCF4\uC790."
    - Coach: seungyeon
      Kind: start
      Text: "\uAE30\uBCF8\uBD80\uD130 \uB2E4\uC2DC \uBCF4\uC790."
    - Coach: seungyeon
      Kind: cue
      Text: "\uAC00\uB4DC \uC62C\uB9AC\uACE0."
    - Coach: seungyeon
      Kind: cue
      Text: "\uC8FC\uBA39 \uB05D\uAE4C\uC9C0 \uBED7\uACE0."
    - Coach: seungyeon
      Kind: cue
      Text: "\uBC1C \uBD99\uC774\uACE0 \uCCD0."
    - Coach: seungyeon
      Kind: cue
      Text: "\uB2E4\uC2DC, \uD55C \uBC88 \uB354."
    - Coach: seungyeon
      Kind: good
      Text: "\uC88B\uC544. \uADF8\uAC8C \uAE30\uBCF8\uC774\uC57C."
    - Coach: seungyeon
      Kind: ok
      Text: "\uAD1C\uCC2E\uC544. \uACC4\uC18D \uD558\uBA74 \uB41C\uB2E4."
    - Coach: seungyeon
      Kind: bad
      Text: "\uCC9C\uCC9C\uD788. \uBE68\uB9AC \uD558\uB294 \uAC74 \uB098\uC911\uC774\uC57C."
    - Coach: seungyeon
      Kind: tip
      Text: "\uAE30\uBCF8\uAE30\uAC00 \uC81C\uC77C \uBE60\uB978 \uAE38\uC774\uC57C."
    - Coach: seungyeon
      Kind: noshow
      Text: "\uC624\uB298 \uC2DC\uAC04 \uBE44\uC6CC \uB480\uB294\uB370 \uBABB \uBD24\uB124.
        \uB2E4\uC74C\uC5D0 \uBCF4\uC790."
    - Coach: seungyeon
      Kind: book
      Text: "\uD1A0\uC694\uC77C\uC5D0 \uBCF4\uC790."
    - Coach: jinsoo_son
      Kind: intro
      Text: "\uAD00\uC7A5\uB2D8\uC774 \uC798 \uBD10 \uB2EC\uB77C\uACE0 \uD558\uC168\uC5B4.
        \uD3B8\uD558\uAC8C \uD574."
    - Coach: jinsoo_son
      Kind: start
      Text: "\uC624\uB298\uC740 \uC0C1\uB300\uAC00 \uB4E4\uC5B4\uC62C \uB54C\uB97C
        \uBCF4\uC790."
    - Coach: jinsoo_son
      Kind: cue
      Text: "\uBCF4\uACE0 \uCCD0."
    - Coach: jinsoo_son
      Kind: cue
      Text: "\uB4E4\uC5B4\uC62C \uB54C."
    - Coach: jinsoo_son
      Kind: cue
      Text: "\uC790\uC138 \uC720\uC9C0."
    - Coach: jinsoo_son
      Kind: cue
      Text: "\uC88B\uC544, \uADF8\uB300\uB85C."
    - Coach: jinsoo_son
      Kind: good
      Text: "\uC88B\uB2E4. \uADF8 \uD0C0\uC774\uBC0D\uC774\uC57C."
    - Coach: jinsoo_son
      Kind: ok
      Text: "\uAD1C\uCC2E\uC544. \uAC10\uC740 \uC7A1\uC558\uC5B4."
    - Coach: jinsoo_son
      Kind: bad
      Text: "\uAE09\uD558\uAC8C \uD558\uC9C0 \uB9C8. \uD558\uB098\uC529."
    - Coach: jinsoo_son
      Kind: tip
      Text: "\uB9DE\uACE0 \uB098\uC11C \uCE58\uB294 \uAC8C \uC544\uB2C8\uB77C, \uB4E4\uC5B4\uC62C
        \uB54C \uCE5C\uB2E4."
    - Coach: jinsoo_son
      Kind: noshow
      Text: "\uC624\uB298 \uBABB \uBD24\uB124. \uB2E4\uC74C\uC5D0 \uC2DC\uAC04 \uB9DE\uCDB0
        \uBCF4\uC790."
    - Coach: jinsoo_son
      Kind: book
      Text: "\uC77C\uC694\uC77C\uC5D0 \uBCF4\uC790."
    - Coach: jinsoo_seo
      Kind: intro
      Text: "\uB3D9\uC791 \uD558\uB098\uB9CC \uBCF4\uC790. \uB9CE\uC774 \uACE0\uCE58\uBA74
        \uD558\uB098\uB3C4 \uC548 \uB0A8\uC544."
    - Coach: jinsoo_seo
      Kind: start
      Text: "\uC9C0\uB09C\uBC88\uC5D0 \uD558\uB358 \uAC70 \uADF8\uB300\uB85C \uD55C
        \uBC88 \uD574 \uBD10."
    - Coach: jinsoo_seo
      Kind: cue
      Text: "\uAC70\uAE30."
    - Coach: jinsoo_seo
      Kind: cue
      Text: "\uADF8 \uBD80\uBD84\uB9CC \uB2E4\uC2DC."
    - Coach: jinsoo_seo
      Kind: cue
      Text: "\uC88B\uC544, \uBC29\uAE08 \uADF8\uAC70."
    - Coach: jinsoo_seo
      Kind: cue
      Text: "\uD798 \uBE7C\uACE0."
    - Coach: jinsoo_seo
      Kind: good
      Text: "\uADF8\uAC70\uC57C. \uC774\uC81C \uB9DE\uAC8C \uD558\uACE0 \uC788\uC5B4."
    - Coach: jinsoo_seo
      Kind: ok
      Text: "\uBC29\uD5A5\uC740 \uB9DE\uC544. \uBC18\uBCF5\uB9CC \uD558\uBA74 \uB3FC."
    - Coach: jinsoo_seo
      Kind: bad
      Text: "\uAD1C\uCC2E\uC544. \uC5B4\uB514\uAC00 \uD2C0\uB838\uB294\uC9C0 \uC54C\uC558\uC796\uC544."
    - Coach: jinsoo_seo
      Kind: fix
      Text: "{\uC9C0\uD45C} \uCABD\uC774 \uD2C0\uB838\uC5B4. \uC774\uAC70 \uD558\uB098\uB9CC
        \uACE0\uCE58\uC790. \uB2E4\uC74C\uC5D0 \uD560 \uB550 \uC774\uAC83\uB9CC \uC0DD\uAC01\uD574."
    - Coach: jinsoo_seo
      Kind: tip
      Text: "\uB04A\uC5B4 \uCE58\uB294 \uAC70\uB791 \uBC00\uC5B4 \uCE58\uB294 \uAC70,
        \uB458\uC740 \uB2EC\uB77C."
    - Coach: jinsoo_seo
      Kind: noshow
      Text: "\uC624\uB298 \uBABB \uC654\uAD6C\uB098. \uACE0\uCE60 \uAC70 \uC801\uC5B4
        \uB458\uAC8C."
    - Coach: jinsoo_seo
      Kind: book
      Text: "\uC77C\uC694\uC77C \uC800\uB141\uC5D0 \uBCF4\uC790."
